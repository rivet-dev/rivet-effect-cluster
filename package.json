{
	"name": "@rivet-dev/effect-cluster",
	"version": "0.1.0",
	"description": "Experimental Effect Cluster backend for Rivet Actors",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rivet-dev/rivet-effect-cluster.git"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"src/**/*.ts",
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"LICENSE",
		"LICENSE-effect",
		"README.md"
	],
	"exports": {
		".": "./src/mod.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/mod.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json && tsc --noEmit -p scripts/release",
		"lint": "biome check .",
		"release": "tsx ./scripts/release/main.ts",
		"example:entities": "pnpm --filter example-entities start",
		"example:entity-sql": "pnpm --filter example-entity-sql start",
		"example:workflows": "pnpm --filter example-workflows start",
		"example:queue-and-cron": "pnpm --filter example-queue-and-cron start"
	},
	"peerDependencies": {
		"effect": "~4.1.4",
		"rivetkit": "^3.1.2-rc.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@effect/language-service": "^0.85.1",
		"@types/node": "^22.18.1",
		"@types/semver": "^7.5.8",
		"commander": "^12.1.0",
		"effect": "4.1.4",
		"execa": "^8.0.1",
		"rivetkit": "3.1.2-rc.6",
		"semver": "^7.6.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.2"
	},
	"packageManager": "pnpm@10.13.1"
}
